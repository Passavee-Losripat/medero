# Meta Model API (never commit the real key)
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
ASR_MODEL=muse-voice-transcribe-1.0
ASR_REALTIME_URL=wss://api.meta.ai/v1/asr/realtime

# Router: "spark" (API), "local" (llama.cpp Glimmer), "modal" (Glimmer on Modal), "rules" (offline baseline)
ROUTER_PROVIDER=spark
LOCAL_LLM_BASE=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=muse-glimmer-q4
MODAL_LLM_BASE=
MODAL_LLM_KEY=
MODAL_LLM_MODEL=muse-glimmer

# Use the fake provider (no network) for local UI work without a key
LLM_FAKE=0

# Model call limits
MODEL_TIMEOUT_S=8
MODEL_MAX_RETRIES=1
VERIFIER_MODEL_CHECK=1

# Demo protection
DEMO_MODE=1
DEMO_RATE_LIMIT_PER_MIN=30
DEMO_DAILY_SPEND_CAP_USD=5

# CORS origin of the web app
WEB_ORIGIN=http://localhost:3000
